                                    transform: scale(1.02);
                                     aspect-ratio: var(--aspect-ratio, 3/4);
                                    opacity: 0.9; /* Slight opacity change for depth */
                                  }

                                  /* Style the secondary image */
                                  .secondary-image {
                                    position: absolute;
                                    top: 0;
                                    left: 0;
                                    transition: opacity 0.3s ease-in-out, transform 1.4s ease-in-out; /* Separate timings */
